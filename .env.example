# Local Compose credentials only. Never reuse in production. Export these variables;
# the API does not automatically load .env files.
APP_ENV=development
PORT=8080
LOG_LEVEL=INFO
DATABASE_URL=postgres://gowork_app:gowork_dev_only@localhost:5432/gowork?sslmode=disable
DB_MAX_CONNS=10
MIGRATION_DATABASE_URL=postgres://gowork_owner:gowork_local_only@localhost:5432/gowork?sslmode=disable
# Integration also requires APP_ENV=test and a fresh disposable database.
TEST_DATABASE_URL=postgres://gowork_owner:gowork_local_only@localhost:5432/gowork_test?sslmode=disable
